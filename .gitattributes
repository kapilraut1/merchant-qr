# Normalize line endings in the repository so that Docker builds and CI behave
# identically on Windows, macOS and Linux checkouts.
* text=auto eol=lf

*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.mako text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Lockfiles must never be rewritten.
package-lock.json -text
